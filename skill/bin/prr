#!/usr/bin/env bash
# Launcher for the prr backend. Works through the ~/.claude/skills/pr-review symlink.
set -euo pipefail

BIN_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$BIN_DIR/../.." && pwd)"
PY="$REPO/.venv/bin/python"

if [ ! -x "$PY" ]; then
  echo "prr: $PY is missing; run $REPO/install.sh" >&2
  exit 1
fi

# -P: don't put the cwd on sys.path, so a "prr" folder in the user's repo can't shadow this package.
exec "$PY" -P -m prr "$@"
