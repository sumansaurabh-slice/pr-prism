@@ -0,0 +1,17 @@
+import pytest
+
+from app.delivery import retry
+
+
+def test_retries_until_success(monkeypatch):
+    monkeypatch.setattr(retry.time, "sleep", lambda _: None)
+    calls = []
+
+    def flaky():
+        calls.append(1)
+        if len(calls) < 3:
+            raise ConnectionError("boom")
+        return "ok"
+
+    assert retry.with_retry(flaky, max_attempts=5) == "ok"
+    assert len(calls) == 3
