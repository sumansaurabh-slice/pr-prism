@@ -0,0 +1,23 @@
+import random
+import time
+from typing import Callable, TypeVar
+
+T = TypeVar("T")
+
+
+def backoff_delays(max_attempts: int, base: float = 0.5, cap: float = 30.0):
+    """Full-jitter exponential backoff: 0.5s, 1s, 2s, ... capped at `cap`."""
+    for attempt in range(max_attempts - 1):
+        yield random.uniform(0, min(cap, base * 2 ** attempt))
+
+
+def with_retry(fn: Callable[[], T], max_attempts: int = 5, retry_on=(Exception,)) -> T:
+    delays = backoff_delays(max_attempts)
+    while True:
+        try:
+            return fn()
+        except retry_on:
+            delay = next(delays, None)
+            if delay is None:
+                raise
+            time.sleep(delay)
